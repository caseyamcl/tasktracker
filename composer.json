{
    "name": "caseyamcl/tasktracker",
    "type": "library",
    "description": "A PHP library for keeping track of progress and stats for long running tasks",
    "keywords": ["task", "asynchronous", "negotiation", "progress", "report", "cli", "tasktracker"],
    "homepage": "https://github.com/caseyamcl/tasktracker",
    "license": "MIT",
    "authors":
    [
        {
            "name":     "Casey McLaughlin",
            "email":    "caseyamcl@gmail.com",
            "homepage": "https://caseymclaughlin.com",
            "role":     "Developer"
        }
    ],
    "require":
    {
        "php" : "^7.4|^8.0",
        "ext-json": "*",
        "symfony/event-dispatcher": "^5.4|^6.4|^7.0"
    },
    "require-dev":
    {
        "symfony/console": "^4.4|^5.4|^6.4|^7.0",
        "psr/log"        : "^1.0|^2.0",
        "monolog/monolog": "^3.9",
        "phpunit/phpunit": "^8.5",
        "mockery/mockery": "^1.0",
    },
    "autoload": {
        "psr-4": { "TaskTracker\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "TaskTracker\\Test\\": "tests/" }
    }
}
